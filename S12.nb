      RowBox[{"x5", "\[Rule]", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "*", "a5"}], "]"}]}]}], "}"}]}]}], 
  ";"}]], "Input",
