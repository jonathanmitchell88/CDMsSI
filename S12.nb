    RowBox[{"{", 
     RowBox[{
      RowBox[{"x1", "\[Rule]", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "2"}], "*", "a1"}], "]"}]}], ",", 
